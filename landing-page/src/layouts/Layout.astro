---
import Seo from '../components/seo/Seo.astro';
interface Props { title: string; description?: string; ogImage?: string; }
const {title,description="Primo centralise les données cadastrales, l’urbanisme, les risques et les informations foncières pour préparer votre projet.",ogImage}=Astro.props;
---
<!doctype html><html lang="fr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><Seo title={title} description={description} image={ogImage}/><link rel="icon" href="/favicon.ico"/></head><body><slot/></body></html>
<style is:global>@import "../styles/global.css";</style>
