---
// Target of the mail campaign QR codes (primo-data.fr/r/<code> -> /bienvenue/?c=<code>).
// The code identifies the agency: the page records the scan in the tracking panel, personalises itself,
// then offers a meeting or a callback. Without a valid code it stays a generic welcome page.
import { ArrowUpRight, CalendarDays, Gift, MessageSquareText, Phone } from 'lucide-react';
import LandingLayout from '../layouts/LandingLayout.astro';
import ParcelStory from '../components/sections/ParcelStory.astro';
import TeamSection from '../components/sections/TeamSection.astro';
import { CONTACT_EMAIL, EXTERNAL_LINKS, OUTREACH } from '../config/constants';

const beta = [
  {
    icon: Gift,
    title: 'Gratuit pendant toute la bêta',
    text: 'Accès complet à Primo : fiches parcelles, assistant IA et espaces de travail partagés avec votre équipe.',
  },
  {
    icon: CalendarDays,
    title: '30 minutes pour démarrer',
    text: 'On vous montre Primo sur vos propres biens, à l’agence ou en visio, au moment qui vous arrange.',
  },
  {
    icon: MessageSquareText,
    title: 'Vos retours décident',
    text: 'Ce qui vous fait gagner du temps au quotidien passe en priorité dans nos développements.',
  },
];
---

<LandingLayout
  title="Bienvenue | Primo"
  description="Primo rassemble cadastre, PLU, DVF, DPE et risques d’une parcelle en un clic. Rejoignez la bêta réservée aux agences toulousaines."
  noindex
>
  <section
    class="welcome shell"
    data-welcome
    data-api={OUTREACH.API_URL}
    data-mail={CONTACT_EMAIL}
    aria-labelledby="welcome-title"
  >
    <p class="eyebrow" data-agence>VOTRE COURRIER PRIMO</p>
    <h1 id="welcome-title">
      Bonjour <b data-qui>et bienvenue</b>.
    </h1>
    <p class="welcome-lead">
      La fiche que vous avez reçue, Primo l’a générée <strong>en un clic</strong> à partir de l’adresse de votre
      agence : cadastre, bâti, DPE, PLU, ventes, permis et risques. Imaginez la même chose pour chaque mandat,
      chaque estimation, chaque visite.
    </p>
    <div class="welcome-actions">
      {
        OUTREACH.BOOKING_URL ? (
          <a class="primary primary-large" href={OUTREACH.BOOKING_URL} target="_blank" rel="noopener" data-clic="rdv">
            Réserver 30 minutes <ArrowUpRight size={20} />
          </a>
        ) : (
          <a class="primary primary-large" href="#rappel">
            Être rappelé <Phone size={20} />
          </a>
        )
      }
      {OUTREACH.BOOKING_URL && <a class="text-link" href="#rappel">Plutôt être rappelé</a>}
      <a class="text-link" href="#fonctionnalites" data-clic="site">
        Voir Primo en action <ArrowUpRight size={16} />
      </a>
    </div>
    <p class="welcome-note" data-note hidden>
      Ce lien est propre à votre agence : il nous indique simplement que notre courrier vous est bien parvenu.
    </p>
  </section>

  <section class="section shell beta-sec" aria-labelledby="beta-title">
    <p class="eyebrow">BÊTA PRIVÉE · TOULOUSE</p>
    <h2 id="beta-title">On cherche 20 agences pour construire Primo avec elles.</h2>
    <p class="section-copy">
      Nous sommes quatre étudiants d’Epitech Toulouse. Depuis deux ans, nous développons Primo pour que les
      données d’une parcelle, aujourd’hui éparpillées sur une dizaine de sites publics, tiennent sur une seule
      fiche. Avant de l’ouvrir plus largement, on veut le confronter au terrain : le vôtre.
    </p>
    <ul class="beta-grid">
      {
        beta.map(({ icon: Icon, title, text }) => (
          <li>
            <Icon size={22} />
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <ParcelStory />

  <TeamSection />

  <section id="rappel" class="section shell contact-sec" aria-labelledby="rappel-title">
    <div class="contact-grid">
      <div class="contact-copy">
        <h2 id="rappel-title">On vous rappelle quand ça vous arrange.</h2>
        <p>
          Laissez un numéro ou un e-mail, on revient vers vous très vite pour caler 30 minutes. Pas de démarchage
          ensuite : si Primo ne vous sert pas, on s’arrête là.
        </p>
        <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        {
          OUTREACH.BOOKING_URL && (
            <a class="text-link" href={OUTREACH.BOOKING_URL} target="_blank" rel="noopener" data-clic="rdv">
              Ou réservez directement un créneau <ArrowUpRight size={16} />
            </a>
          )
        }
      </div>
      <form class="contact-form" data-rappel novalidate>
        <div class="contact-row">
          <label>
            <span>Nom</span>
            <input name="nom" type="text" autocomplete="name" required placeholder="Votre nom" />
          </label>
          <label>
            <span>Téléphone</span>
            <input name="telephone" type="tel" autocomplete="tel" placeholder="06 12 34 56 78" />
          </label>
        </div>
        <div class="contact-row">
          <label>
            <span>E-mail</span>
            <input name="email" type="email" autocomplete="email" placeholder="vous@agence.fr" />
          </label>
          <label>
            <span>Meilleur moment</span>
            <select name="creneau">
              <option value="">Peu importe</option>
              <option>Le matin</option>
              <option>Le midi</option>
              <option>L’après-midi</option>
              <option>En fin de journée</option>
            </select>
          </label>
        </div>
        <label>
          <span>Message (facultatif)</span>
          <textarea name="message" rows="3" placeholder="Une question, un besoin précis…"></textarea>
        </label>
        <label class="hp" aria-hidden="true">
          Site <input name="site" type="text" tabindex="-1" autocomplete="off" />
        </label>
        <div class="contact-foot">
          <p class="contact-status" data-status role="status"></p>
          <button type="submit" class="primary primary-large">
            Être rappelé <ArrowUpRight size={20} />
          </button>
        </div>
        <p class="contact-legal">
          Vos coordonnées servent uniquement à vous recontacter au sujet de Primo.
          <a href="/confidentialite/">Confidentialité</a> · Pour ne plus être contacté, écrivez « STOP » à
          {CONTACT_EMAIL}.
        </p>
      </form>
    </div>
  </section>

  <div class="mid-cta shell">
    <a class="primary primary-large" href={EXTERNAL_LINKS.APP_URL} data-clic="beta">
      Créer mon accès bêta <ArrowUpRight size={20} />
    </a>
  </div>
</LandingLayout>

<script>
  type Agence = { nom: string; contact: string | null; variante: 'A' | 'B' };

  const root = document.querySelector<HTMLElement>('[data-welcome]')!;
  const api = root.dataset.api!.replace(/\/$/, '');
  const raw = new URLSearchParams(location.search).get('c') ?? '';
  const code = /^[A-Za-z0-9]{4,12}$/.test(raw) ? raw : null;
  let agence: Agence | null = null;

  // text/plain keeps it a CORS "simple request": no preflight.
  const post = (path: string, body: object) =>
    fetch(`${api}/api/public/${path}`, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
      body: JSON.stringify({ c: code, ...body }),
    });

  if (code) {
    post('scan', {})
      .then((res) => (res.ok ? res.json() : null))
      .then((data: Agence | null) => {
        if (!data) return;
        agence = data;
        root.querySelector('[data-agence]')!.textContent = data.nom.toUpperCase();
        root.querySelector('[data-qui]')!.textContent = data.contact || data.nom;
        root.querySelector<HTMLElement>('[data-note]')!.hidden = false;
      })
      .catch(() => {});
  }

  // Action button clicks: sendBeacon survives the navigation that follows the click.
  document.querySelectorAll<HTMLElement>('[data-clic]').forEach((el) =>
    el.addEventListener('click', () => {
      if (!code || !agence) return;
      const body = JSON.stringify({ c: code, cible: el.dataset.clic });
      navigator.sendBeacon?.(`${api}/api/public/clic`, new Blob([body], { type: 'text/plain' }));
    }),
  );

  const form = document.querySelector<HTMLFormElement>('[data-rappel]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (!d.nom.trim() || (!d.telephone.trim() && !d.email.trim())) {
      form.classList.add('was-checked');
      status.textContent = 'Indiquez votre nom et un téléphone ou un e-mail.';
      return;
    }

    button.disabled = true;
    status.textContent = 'Envoi…';
    try {
      // No agency code (direct visit): the request lands in the panel's "Messages" section instead.
      const res = agence
        ? await post('contact', d)
        : await fetch(`${api}/api/public/message`, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
            body: JSON.stringify({ source: 'bienvenue', ...d }),
          });
      if (!res.ok) throw new Error();
      form.reset();
      status.textContent = 'Merci ! On vous recontacte très vite.';
    } catch {
      status.textContent = `L’envoi a échoué. Écrivez-nous à ${root.dataset.mail}.`;
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .welcome {
    padding-top: 150px;
    padding-bottom: 70px;
  }
  /* No <span>: the landing's mint h1 highlight breaks when an agency name wraps. */
  .welcome h1 {
    max-width: 18ch;
    font-size: clamp(40px, 5.2vw, 68px);
    letter-spacing: -2.6px;
  }
  .welcome h1 b {
    font-weight: inherit;
  }
  .welcome-lead {
    max-width: 640px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
  }
  .welcome-lead strong {
    color: var(--ink);
  }
  .welcome-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
    margin-top: 34px;
  }
  .welcome-note {
    margin-top: 26px;
    font-size: 13px;
    color: var(--muted);
  }
  .beta-sec {
    padding-top: 40px;
  }
  .beta-sec .section-copy {
    max-width: 720px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }
  .beta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  .beta-grid li {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }
  .beta-grid :global(svg) {
    color: var(--accent);
  }
  .beta-grid h3 {
    margin: 14px 0 6px;
    font-size: 18px;
  }
  .beta-grid p {
    margin: 0;
    line-height: 1.5;
    color: var(--muted);
  }
  .contact-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .contact-legal {
    margin: 4px 0 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }
  .contact-legal a {
    text-decoration: underline;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  @media (max-width: 860px) {
    .welcome {
      padding-top: 120px;
    }
    .beta-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .shell.welcome,
    .shell.beta-sec {
      padding-inline: 16px;
    }
  }
</style>
