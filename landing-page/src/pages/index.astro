---
import { ArrowUpRight } from 'lucide-react';
import LandingLayout from '../layouts/LandingLayout.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import ParcelStory from '../components/sections/ParcelStory.astro';
import ToolsSection from '../components/sections/ToolsSection.astro';
import ProjectSection from '../components/sections/ProjectSection.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import TeamSection from '../components/sections/TeamSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import PricingSection from '../components/sections/PricingSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import { EXTERNAL_LINKS } from '../config/constants';
import { FAQ, faqSchema } from '../data/faq';
---

<LandingLayout
  title="Primo | Prospection foncière et données cadastrales"
  description="Cadastre, PLU, prix DVF, DPE et risques d’une parcelle sur une seule fiche, à partager en équipe. Pour les pros de l’immobilier et les particuliers."
  schema={[faqSchema(FAQ)]}
  intro
>
  <HeroSection />
  <ParcelStory />
  <div class="mid-cta shell">
    <a class="primary primary-large" href={EXTERNAL_LINKS.APP_URL}>
      Découvrir la bêta <ArrowUpRight size={20} />
    </a>
  </div>
  <ToolsSection />
  <ProjectSection />
  <Testimonials />
  <TeamSection />
  <FaqSection />
  <PricingSection />
  <ContactSection />
</LandingLayout>
