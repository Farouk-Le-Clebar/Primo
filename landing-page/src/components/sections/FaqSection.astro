---
import { ArrowUpRight } from 'lucide-react';
import { FAQ } from '../../data/faq';
---

<section class="section shell faq-section" id="questions">
  <div class="section-heading reveal">
    <div>
      <h2>Questions fréquentes</h2>
    </div>
    <a class="text-link" href="/blog/">
      Consulter les guides fonciers <ArrowUpRight size={18} />
    </a>
  </div>
  <div class="faq-list">
    {FAQ.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p set:html={item.answer} />
      </details>
    ))}
  </div>
</section>
