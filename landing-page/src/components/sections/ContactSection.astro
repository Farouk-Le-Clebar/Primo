---
// Contact form. Messages are sent to the tracking panel (OUTREACH.API_URL, "Messages" section);
// if the panel can't be reached, the visitor's mail app opens with the message pre-filled instead.
import { ArrowUpRight, Mail } from 'lucide-react';
import { CONTACT_EMAIL as EMAIL, OUTREACH } from '../../config/constants';
---

<section id="contact" class="section shell contact-sec">
  <div class="contact-grid">
    <div class="contact-copy reveal">
      <h2>Nous contacter</h2>
      <p>Une question sur Primo ou envie d’une démonstration pour votre équipe ? Écrivez-nous.</p>
      <a class="text-link" href={`mailto:${EMAIL}`}>
        <Mail size={16} /> {EMAIL}
      </a>
    </div>
    <form class="contact-form reveal" data-contact={EMAIL} data-api={OUTREACH.API_URL} novalidate>
      <div class="contact-row">
        <label>
          <span>Nom</span>
          <input name="name" type="text" autocomplete="name" required placeholder="Votre nom" />
        </label>
        <label>
          <span>E-mail</span>
          <input name="email" type="email" autocomplete="email" required placeholder="vous@exemple.fr" />
        </label>
      </div>
      <label>
        <span>Message</span>
        <textarea name="message" rows="5" required placeholder="Votre message"></textarea>
      </label>
      <label class="hp" aria-hidden="true">
        Site <input name="site" type="text" tabindex="-1" autocomplete="off" />
      </label>
      <div class="contact-foot">
        <p class="contact-status" data-contact-status role="status"></p>
        <button type="submit" class="primary primary-large">
          Envoyer <ArrowUpRight size={20} />
        </button>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-contact-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const api = form.dataset.api!.replace(/\/$/, '');

    const openMail = (d: FormData) => {
      const subject = `Contact depuis primo-data.fr — ${d.get('name')}`;
      const body = `${d.get('message')}\n\n${d.get('name')}\n${d.get('email')}`;
      window.location.href = `mailto:${form.dataset.contact}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      status.textContent = 'Votre messagerie s’ouvre avec le message prêt à envoyer.';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.classList.add('was-checked');
        status.textContent = 'Merci de remplir tous les champs.';
        return;
      }
      const d = new FormData(form);
      button.disabled = true;
      status.textContent = 'Envoi…';
      try {
        // text/plain keeps it a CORS "simple request": no preflight.
        const res = await fetch(`${api}/api/public/message`, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
          body: JSON.stringify({
            source: 'accueil',
            nom: d.get('name'),
            email: d.get('email'),
            message: d.get('message'),
            site: d.get('site'),
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        form.classList.remove('was-checked');
        status.textContent = 'Merci ! Votre message est bien parti, on vous répond très vite.';
      } catch {
        openMail(d);
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .hp {
    position: absolute;
    left: -9999px;
  }
</style>
