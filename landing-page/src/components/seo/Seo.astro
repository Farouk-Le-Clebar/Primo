---
interface Props { title: string; description: string; image?: string; noindex?: boolean; }
const {title, description, image='/images/primo-map.webp', noindex=false}=Astro.props;
const base=Astro.site || new URL('https://primo-data.fr');
const path=Astro.url.pathname;
const canonical=new URL(path==='/'?'/':path.replace(/\/$/,'')+'/',base).href;
const home=new URL('/',base).href;
const imageURL=new URL(image,base).href;
const graph=[
 {'@type':'Organization','@id':home+'#organization',name:'Primo',url:home,logo:new URL('/logo-primo.svg',base).href,sameAs:['https://www.linkedin.com/company/primo-data-app/','https://www.instagram.com/primo.app/'],email:'contact@primo-data.fr'},
 {'@type':'WebSite','@id':home+'#website',url:home,name:'Primo',inLanguage:'fr-FR',publisher:{'@id':home+'#organization'}},
 {'@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description,inLanguage:'fr-FR',isPartOf:{'@id':home+'#website'},about:{'@id':home+'#organization'}},
 ...(path==='/'?[{'@type':'SoftwareApplication','@id':home+'#application',name:'Primo',url:home,applicationCategory:'BusinessApplication',operatingSystem:'Web',inLanguage:'fr-FR',description:'Application de recherche de parcelles cadastrales en France : critères géographiques, données foncières et espace projet collaboratif.',publisher:{'@id':home+'#organization'}}]:[])
];
---
<title>{title}</title>
<meta name="description" content={description}/>
<meta name="robots" content={noindex?'noindex, follow':'index, follow, max-image-preview:large'}/>
<link rel="canonical" href={canonical}/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="Primo"/>
<meta property="og:locale" content="fr_FR"/><meta property="og:url" content={canonical}/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/>
<meta property="og:image" content={imageURL}/><meta property="og:image:alt" content="Primo : recherche de parcelles et analyse cadastrale sur une carte interactive"/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/>
<meta name="twitter:description" content={description}/><meta name="twitter:image" content={imageURL}/>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/>
