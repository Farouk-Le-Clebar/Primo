---
import { ArrowUpRight } from 'lucide-react';
import Logo from '../../assets/logos/logoPrimoBlack.svg?url';
import BrandIcon from '../icons/BrandIcon.astro';
import { EXTERNAL_LINKS, LEGAL_LINKS } from '../../config/constants';
---

<footer class="shell">
  <div class="footer-main">
    <div>
      <a href="/" class="brand">
        <img src={Logo} alt="" width="29" height="29" />
        Primo
      </a>
      <p>La parcelle en un clic.</p>
    </div>
    <div class="footer-social">
      <a href={EXTERNAL_LINKS.EMAIL}>
        Nous contacter <ArrowUpRight size={16} />
      </a>
      <a href={EXTERNAL_LINKS.LINKEDIN} aria-label="Primo sur LinkedIn" rel="me noopener">
        <BrandIcon name="linkedin" />
      </a>
      <a href={EXTERNAL_LINKS.INSTAGRAM} aria-label="Primo sur Instagram" rel="me noopener">
        <BrandIcon name="instagram" />
      </a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Primo. Tous droits réservés.</span>
    <nav aria-label="Informations légales">
      {LEGAL_LINKS.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <span>Imaginé en France.</span>
  </div>
</footer>
