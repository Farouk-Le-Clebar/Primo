server {
  listen 80;
  server_name primoLandingServer;

  root /usr/share/nginx/html;
  index index.html index.htm;

  # Relative redirects (/cgu -> /cgu/), so the scheme/port of the proxy in front is kept.
  absolute_redirect off;

  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml font/woff2;

  error_page 404 /404.html;
  location = /404.html { internal; }

  # Legacy component URL: redirect to the canonical landing page.
  location = /home/Home { return 301 /; }
  location = /home/Home/ { return 301 /; }

  location / {
    try_files $uri $uri/ =404;
  }

  # Fingerprinted build assets (CSS, JS, fonts, images): cache for a year.
  # add_header in a location drops the server-level ones, hence the repeated nosniff.
  location /_astro/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff;
    try_files $uri =404;
  }

  location = /env-config.js {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
  }

  add_header X-Content-Type-Options nosniff;
  add_header X-Frame-Options SAMEORIGIN;
  add_header Referrer-Policy strict-origin-when-cross-origin;
}
